[Unit]
Description=MUDBench local AI (Qwen2.5 3B, CPU)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.mudbench/local-ai/llama.cpp
ExecStart=%h/.mudbench/local-ai/llama.cpp/build/bin/llama-server -m %h/.mudbench/models/qwen2.5-3b-instruct-q4_k_m.gguf -c 8192 -t 20 -tb 20 --host 127.0.0.1 --port 8081 -np 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
