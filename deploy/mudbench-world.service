[Unit]
Description=MUDBench world server
StartLimitIntervalSec=60
StartLimitBurst=5
After=mudbench-holo.service
Wants=mudbench-holo.service

[Service]
Type=simple
WorkingDirectory=/home/callard/mudbenchmark/runtime
Environment=DECOY_MODE=corroborated
Environment=RESPAWN_AT_START=false
Environment=STATE_FILE=%h/.mudbench/state/world.json
Environment=PRISM_ORIGINS=https://play.r4labs.org
Environment=IDENTITY_FILE=%h/.mudbench/state/identities.json
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
