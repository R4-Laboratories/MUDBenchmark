+def _read_note_lines():
+    if not os.path.exists(MEMORY_NOTES_FILE):
+        return []
+    lines = []
+    with open(MEMORY_NOTES_FILE, "r", encoding="utf-8") as handle:
+        for line in handle:
+            line = line.strip()
+            if line:
+                lines.append(line)
+    return lines
+
+
+def compact_memory_notes():
+    """Keep the journal bounded and drop old notes; preserve the newest copy."""
+    global NOTE_COUNT
+    lines = _read_note_lines()
+    cutoff = time.time() - MEMORY_RETENTION_DAYS * 86400
+    kept = {}
+    for line in lines:
+        try:
+            note = json.loads(line)
+        except Exception:
+            continue
+        at = note.get("at")
+        if isinstance(at, (int, float)) and at < cutoff:
+            continue
+        identity = str(note.get("identity", "")).strip()
+        text = str(note.get("text", "")).strip()
+        if not identity or not text:
+            continue
+        kept[(identity, text)] = {"identity": identity, "text": text, "at": at if isinstance(at, (int, float)) else time.time()}
+    ordered = list(kept.values())[-MEMORY_MAX_NOTES:]
+    tmp = f"{MEMORY_NOTES_FILE}.tmp"
+    with open(tmp, "w", encoding="utf-8") as handle:
+        for note in ordered:
+            handle.write(json.dumps(note) + "\n")
+    os.replace(tmp, MEMORY_NOTES_FILE)
+    NOTE_COUNT = len(ordered)
+    return NOTE_COUNT
+
+
+def append_memory_note(identity, text):
+    global NOTE_COUNT
+    with open(MEMORY_NOTES_FILE, "a", encoding="utf-8") as handle:
+        handle.write(json.dumps({"identity": identity, "text": text, "at": time.time()}) + "\n")
+    NOTE_COUNT += 1
+    if NOTE_COUNT > MEMORY_MAX_NOTES * 1.2:
+        compact_memory_notes()
+
+
+def load_memory_notes():
+    global NOTE_COUNT
+    if not os.path.exists(MEMORY_NOTES_FILE):
+        NOTE_COUNT = 0
+        return 0
+    compact_memory_notes()
+    loaded = 0
+    with open(MEMORY_NOTES_FILE, "r", encoding="utf-8") as handle:
+        for line in handle:
+            try:
+                note = json.loads(line)
+                text = str(note.get("text", "")).strip()
+                identity = str(note.get("identity", "")).strip()
+                if text and identity:
+                    index_single_sentence(text, identity=identity)
+                    loaded += 1
+            except Exception:
+                continue
+    NOTE_COUNT = loaded
+    print(f"[+] Loaded {loaded} game memory notes (max {MEMORY_MAX_NOTES}, {MEMORY_RETENTION_DAYS}d)")
+    return loaded
+
+
